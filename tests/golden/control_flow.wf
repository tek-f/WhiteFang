func classify(int n) {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    }
    return 1;
} -> int

func start() {
    PRINT(classify(-5));
    PRINT(classify(0));
    PRINT(classify(5));

    let int: x = 1;
    if (true) {
        let int: x = 2;
        PRINT(x);
    }
    PRINT(x);

    return 0;
} -> int
